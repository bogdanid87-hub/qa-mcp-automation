# Dependencies
node_modules/

# Playwright output
test-results/
playwright-report/

# Auth state (created at runtime by global.setup.ts)
test-data/.auth/

# Local config — contains your API key and absolute path; never commit this
.claude/settings.local.json

# Workspace — user inputs and tool-generated working files
# The workspace/ folder is gitignored by default.
# To share a specific output with your team, force-add it: git add -f workspace/APP_KNOWLEDGE.md
workspace/*
!workspace/.gitkeep
!workspace/my-test.txt

# Backward compat — also ignore if someone creates these in the root (old habit)
my-test.txt
prd.md

# Archive of pre-regeneration files — kept for comparison only
.qa-archive/

# macOS
.DS_Store
.setup-guide.md
.qa-notes.md
test-data/.auth/loggedIn.json
