{
  "name": "qa-mcp-automation",
  "version": "1.0.0",
  "description": "AI-powered Playwright test generation engine (MCP server) — config-driven via mcp-qa.config.json, with a complete reference implementation for automationexercise.com.",
  "main": "src/index.ts",
  "scripts": {
    "generate": "tsx src/cli.ts",
    "fix": "tsx src/fix-cli.ts",
    "update_registry": "tsx src/update-registry-cli.ts",
    "sync_registry": "tsx src/sync-registry-cli.ts",
    "analyze_prd": "tsx src/analyze-prd-cli.ts",
    "analyze_coverage": "tsx src/analyze-coverage-cli.ts",
    "tag_tests": "tsx src/tag-tests-cli.ts",
    "status": "tsx src/status-cli.ts",
    "generate_api": "tsx src/cli.ts --type api",
    "generate_auth": "tsx src/generate-auth-fixture-cli.ts",
    "generate_mock": "tsx src/generate-mock-cli.ts",
    "audit_site": "tsx src/site-audit-cli.ts",
    "generate_knowledge": "tsx src/generate-app-knowledge-cli.ts",
    "init_project": "tsx src/init-project-cli.ts",
    "mcp": "tsx src/index.ts",
    "test": "playwright test --project=setup --project=chromium",
    "test:all-browsers": "playwright test --project=setup --project=chromium --project=firefox --project=webkit",
    "test:chromium": "playwright test --project=setup --project=chromium",
    "test:firefox": "playwright test --project=setup --project=firefox",
    "test:webkit": "playwright test --project=setup --project=webkit",
    "test:visual": "playwright test --project=setup --project=visual",
    "test:update-snapshots": "playwright test --project=setup --project=visual --update-snapshots",
    "test:headed": "playwright test --project=chromium --headed",
    "test:debug": "playwright test --project=chromium --debug",
    "test:report": "playwright show-report",
    "test:unit": "vitest run",
    "lint": "eslint src/ scripts/",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
